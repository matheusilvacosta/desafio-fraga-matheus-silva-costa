        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Response contains bookingid\", function () {\r\n    pm.expect(response).to.have.property(\"bookingid\");\r\n});\r\n\r\npm.test(\"Response contains booking object\", function () {\r\n    pm.expect(response).to.have.property(\"booking\");\r\n});\r\n\r\npm.test(\"Firstname is correct\", function () {\r\n    pm.expect(response.booking.firstname).to.eql(\"Matheus\");\r\n});\r\n\r\npm.test(\"Lastname is correct\", function () {\r\n    pm.expect(response.booking.lastname).to.eql(\"Silva Teste\");\r\n});\r\n\r\npm.test(\"Total price is correct\", function () {\r\n    pm.expect(response.booking.totalprice).to.eql(200);\r\n});\r\n\r\npm.test(\"Deposit paid is correct\", function () {\r\n    pm.expect(response.booking.depositpaid).to.eql(true);\r\n});\r\n\r\npm.environment.set(\"bookingId\", response.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\" : \"Matheus\",\n    \"lastname\" : \"Silva Teste\",\n    \"totalprice\" : 200,\n    \"depositpaid\" : true,\n    \"bookingdates\": {\n    \"checkin\": \"2026-10-10\",\n    \"checkout\": \"2026-10-15\"\n    },\n    \"additionalneeds\" : \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
