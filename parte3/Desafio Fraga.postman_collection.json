        {
          "name": "Update Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Firstname was preserved\", function () {\r\n    pm.expect(response.firstname).to.eql(\"Matheus\");\r\n});\r\n\r\npm.test(\"Lastname was updated\", function () {\r\n    pm.expect(response.lastname).to.eql(\"Costa Teste\");\r\n});\r\n\r\npm.test(\"Total price was updated\", function () {\r\n    pm.expect(response.totalprice).to.eql(300);\r\n});\r\n\r\npm.test(\"Deposit paid was updated\", function () {\r\n    pm.expect(response.depositpaid).to.eql(false);\r\n});\r\n\r\npm.test(\"Check-in date was updated\", function () {\r\n    pm.expect(response.bookingdates.checkin).to.eql(\"2026-10-12\");\r\n});\r\n\r\npm.test(\"Check-out date was updated\", function () {\r\n    pm.expect(response.bookingdates.checkout).to.eql(\"2026-10-18\");\r\n});\r\n\r\npm.test(\"Additional needs was updated\", function () {\r\n    pm.expect(response.additionalneeds).to.eql(\"Booking Atualizado\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
